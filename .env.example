# ============================================================
# Application
# ============================================================

APP_NAME=Chess Agent
APP_VERSION=0.1.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO


# ============================================================
# HTTP
# ============================================================

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRY_ATTEMPTS=3
HTTP_RETRY_DELAY_SECONDS=1.0
HTTP_MAX_CONNECTIONS=20
HTTP_USER_AGENT=ChessAgent/1.0


# ============================================================
# Hugging Face
# ============================================================

HF_TOKEN=


# ============================================================
# MongoDB
# ============================================================

# Exécution dans Docker.
MONGODB_URI=mongodb://mongodb:27017

# Exécution locale.
# MONGODB_URI=mongodb://localhost:27017

MONGODB_DATABASE=chess_agent
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_MAX_POOL_SIZE=20
MONGODB_RESPONSE_PREVIEW_LENGTH=200

MONGODB_HISTORY_DEFAULT_LIMIT=20
MONGODB_HISTORY_MAX_LIMIT=100


# ============================================================
# Milvus
# ============================================================

# Exécution dans Docker.
MILVUS_HOST=milvus

# Exécution locale.
# MILVUS_HOST=localhost

MILVUS_PORT=19530
MILVUS_TIMEOUT_SECONDS=10

MILVUS_COLLECTION_NAME=wikichess

MILVUS_METRIC_TYPE=COSINE
MILVUS_INDEX_TYPE=HNSW

MILVUS_INDEX_M=16
MILVUS_INDEX_EF_CONSTRUCTION=200
MILVUS_SEARCH_EF=64

MILVUS_IVF_NLIST=1024
MILVUS_IVF_NPROBE=16

MILVUS_SEARCH_LIMIT=5


# ============================================================
# Embeddings
# ============================================================

EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MAX_BATCH_SIZE=16
EMBEDDING_MAX_TEXT_LENGTH=20000
EMBEDDING_DEVICE=cpu

# ============================================================
# RAG
# ============================================================

RAG_SEARCH_TOP_K=5
LLM_MAX_CONTEXT_DOCUMENTS=5


# ============================================================
# Stockfish
# ============================================================

# Exécution dans Docker.
STOCKFISH_PATH=/usr/games/stockfish

# Exécution locale sous Windows.
# STOCKFISH_PATH=C:/Program Files/Stockfish/stockfish-windows-x86-64-avx2.exe

STOCKFISH_DEPTH=15
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=128
STOCKFISH_TIMEOUT_SECONDS=30

TOP_MOVES=3


# ============================================================
# Lichess
# ============================================================

LICHESS_API_URL=https://explorer.lichess.ovh
LICHESS_TOKEN=
LICHESS_TIMEOUT_SECONDS=10
LICHESS_MAX_MOVES=20


# ============================================================
# YouTube
# ============================================================

YOUTUBE_API_KEY=
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_SEARCH_MAX_RESULTS=5
YOUTUBE_REGION_CODE=FR
YOUTUBE_TIMEOUT_SECONDS=15
YOUTUBE_DEFAULT_LANGUAGE=fr
YOUTUBE_QUERY_SUFFIX=chess opening tutorial explanation

MAX_SELECTED_VIDEOS=5


# ============================================================
# Modèle de langage
# ============================================================

LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct

# Exécution dans Docker.
LLM_BASE_URL=http://ollama:11434

# Exécution locale.
# LLM_BASE_URL=http://localhost:11434

LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=240
LLM_NUM_PREDICT=1500


# ============================================================
# Agent
# ============================================================

MAX_AGENT_ITERATIONS=10


# ============================================================
# Frontend
# ============================================================

FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=["http://localhost:4200"]
API_DOCS_ENABLED=true


# ============================================================
# Script Wikichess - Téléchargement
# ============================================================

WIKICHESS_REQUEST_TIMEOUT_SECONDS=30
WIKICHESS_REQUEST_DELAY_SECONDS=1.0

WIKICHESS_MIN_DESCRIPTION_LENGTH=20
WIKICHESS_MAX_DESCRIPTION_LENGTH=300

WIKICHESS_MIN_STATISTICS_GAMES=10
WIKICHESS_MAX_STATISTICAL_RESPONSES=10

WIKICHESS_DEFAULT_LANGUAGE=en
WIKICHESS_REPLACE_EXISTING_FILES=true
WIKICHESS_STRICT_ROBOTS_POLICY=false


# ============================================================
# Script Wikichess - Chunking
# ============================================================

WIKICHESS_CHUNK_SIZE=1200
WIKICHESS_CHUNK_OVERLAP=200
WIKICHESS_MIN_CHUNK_LENGTH=100


# ============================================================
# Script Wikichess - Ingestion
# ============================================================

WIKICHESS_REPLACE_EXISTING_DOCUMENTS=true
WIKICHESS_MILVUS_INSERT_BATCH_SIZE=100
WIKICHESS_EXPORT_PREPARED_CHUNKS=true